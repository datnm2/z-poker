DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
WEB_ORIGIN=http://localhost:3030
PORT=3031
GEMINI_API_KEY=your-gemini-api-key
# Optional AI creativity tuning (sampling params). Unset => code defaults below.
# Higher temperature = more creative/varied. NOTE: Gemini 3 can degrade/loop
# above ~1.0; dial these back to 1.0 if output gets repetitive.
AI_HIGHLIGHTS_TEMPERATURE=1.3
AI_HIGHLIGHTS_TOP_P=0.97
AI_RECAP_TEMPERATURE=1.15
AI_RECAP_TOP_P=0.95
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@z-poker.app
# Local-only auth bypass (ignored when NODE_ENV=production). Set both, then send header `x-debug-token: <DEBUG_API_TOKEN>`.
DEBUG_API_TOKEN=
DEBUG_USER_EMAIL=
